set shell := ["zsh", "-lc"]
set dotenv-path := "../../../../setup.env"
set dotenv-load
set dotenv-required := false

# State encryption passphrase — passed to OpenTofu via TF_ENCRYPTION.
# Add STATE_ENCRYPTION_PASSPHRASE=<passphrase> to setup.env (do not use double quotes in the value).
export TF_ENCRYPTION := if env_var_or_default("STATE_ENCRYPTION_PASSPHRASE", "") != "" { \
    'key_provider "pbkdf2" "main" { passphrase = "' + env_var("STATE_ENCRYPTION_PASSPHRASE") + '" }' \
} else { "" }

[private]
default:
    @just --list

# Generate terraform.tfvars from setup.env; SSH keys fetched from agent or ~/.ssh/*.pub
configure:
    #!/usr/bin/env bash
    set -euo pipefail
    ssh_keys=$(ssh-add -L 2>/dev/null || true)
    if [[ -z "$ssh_keys" ]]; then
        for f in ~/.ssh/id_ed25519.pub ~/.ssh/id_rsa.pub ~/.ssh/id_ecdsa.pub; do
            [[ -f "$f" ]] && ssh_keys+="$(cat "$f")"$'\n'
        done
        ssh_keys="${ssh_keys%$'\n'}"
    fi
    if [[ -z "$ssh_keys" ]]; then
        echo "Error: no SSH keys found — load keys with ssh-add, or place a public key in ~/.ssh/*.pub" >&2
        exit 1
    fi
    keys_hcl=""
    while IFS= read -r key; do
        [[ -n "$key" ]] && keys_hcl+="  \"${key}\","$'\n'
    done <<< "$ssh_keys"
    bridge="${VM_BRIDGE_INTERFACE:-br0}"
    {
        printf 'libvirt_uri = "qemu+ssh://%s@%s/system"\n\n' "$HYPERVISOR_USER" "$HYPERVISOR_HOST"
        printf 'ssh_authorized_keys = [\n%s]\n\n' "$keys_hcl"
        if [[ "$bridge" != "null" ]]; then
            printf 'bridge_interface = "%s"\n\n' "$bridge"
        fi
    } > terraform.tfvars
    echo "Created terraform.tfvars ($(echo "$ssh_keys" | grep -c .) SSH key(s))"

# Initialize OpenTofu providers and modules
init:
    tofu init

# Preview changes without applying
plan:
    tofu plan

# Apply the configuration
apply:
    tofu apply

# Destroy all managed resources
destroy:
    tofu destroy

# Show IP and SSH command for all VMs and runners
ips:
    tofu output -json | jq -r '[.vms.value // {}, .runners.value // {}] | add | to_entries[] | "\(.key): \(.value.ssh)"'

# SSH into a named VM or runner: just ssh <name>
ssh vm:
    #!/usr/bin/env bash
    set -euo pipefail
    ip=$(tofu output -json | jq -re '([.vms.value // {}, .runners.value // {}] | add) | .["{{vm}}"].ip')
    if [[ -z "$ip" || "$ip" == "null" ]]; then
        echo "Error: '{{vm}}' not found — run 'just apply' first" >&2
        exit 1
    fi
    exec ssh "ubuntu@$ip"
